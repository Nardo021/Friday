{
  "name": "friday-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @friday/desktop",
    "build": "npm run build -w @friday/agent-core && npm run build -w @friday/bridge-client && npm run build -w @friday/desktop && npm run build -w @friday/mobile",
    "typecheck:mobile": "npm run typecheck -w @friday/mobile",
    "tauri": "npm run tauri -w @friday/desktop",
    "tauri:dev": "npm run tauri dev -w @friday/desktop",
    "tauri:build": "npm run tauri build -w @friday/desktop"
  }
}
